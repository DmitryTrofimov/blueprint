ANYMODEL_API_KEY=your-anymodel-api-key
ANYMODEL_DEFAULT_MODEL=cx/gpt-5.6-luna
# ANYMODEL_BASE_URL=https://anymodel.org/v1

# For local `supabase functions serve` (hosted deploy sets these automatically)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Telegram bot (Edge Function `telegram-bot`, long polling via getUpdates)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
# Optional: protect poll endpoint (Authorization: Bearer … or X-Telegram-Poll-Secret)
# TELEGRAM_POLL_SECRET=your-random-secret
